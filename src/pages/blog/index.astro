---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';
import { createPublicContentClient } from '../../lib/server/supabase';
import type { Post } from '../../lib/server/posts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let posts: Post[] = [];
let unavailable = false;
try {
  const { data, error } = await createPublicContentClient().from('blog_posts')
    .select('id,title,slug,excerpt,published_at,status')
    .eq('status', 'published').lte('published_at', new Date().toISOString())
    .order('published_at', { ascending: false });
  if (error) unavailable = true;
  else posts = (data ?? []) as Post[];
} catch {
  unavailable = true;
}
if (unavailable) Astro.response.status = 503;
---

<Base titleKey="meta.blogTitle" descriptionKey="meta.blogDescription">
  <section class="page-head reveal show" aria-labelledby="blog-title">
    <p class="kicker" data-i18n="pages.blog.kicker">{t('pages.blog.kicker')}</p>
    <h1 id="blog-title" class="page-title" data-i18n="pages.blog.title">{t('pages.blog.title')}</h1>
    <p class="page-intro" data-i18n="pages.blog.intro">{t('pages.blog.intro')}</p>
  </section>
  <section class="section" aria-label={t('pages.blog.title')} data-i18n-aria="pages.blog.title">
    {unavailable ? <p role="status" class="muted">The journal is temporarily unavailable.</p> : posts.length === 0 ? (
      <div class="journal-empty">
        <span class="journal-mark" aria-hidden="true">✳</span>
        <h2 data-i18n="pages.blog.emptyTitle">{t('pages.blog.emptyTitle')}</h2>
        <p class="muted" data-i18n="pages.blog.emptyText">{t('pages.blog.emptyText')}</p>
        <a class="btn" href={import.meta.env.BASE_URL} data-i18n="pages.blog.back">{t('pages.blog.back')}</a>
      </div>
    ) : <ul class="journal-list">{posts.map((post) => <li lang="en">
      <a href={`/blog/${post.slug}/`}><h2>{post.title}</h2></a>
      <time datetime={post.published_at ?? ''}>{post.published_at ? new Date(post.published_at).toLocaleDateString('en-GB', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) : ''}</time>
      {post.excerpt && <p>{post.excerpt}</p>}
    </li>)}</ul>}
  </section>
</Base>

<style>
  .page-head .kicker { margin-bottom: 10px; }
  .journal-empty { padding: 48px 24px; border: 1px dashed var(--line-strong); border-radius: var(--radius); background: var(--surface); text-align: center; }
  .journal-mark { display: block; margin-bottom: 14px; color: var(--accent); font-size: 24px; }
  .journal-empty h2 { font-size: 17px; font-weight: 600; }
  .journal-empty p { margin: 8px auto 22px; max-width: 40ch; }
  .journal-list { padding: 0; list-style: none; }
  .journal-list li { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .journal-list li:first-child { padding-top: 0; }
  .journal-list h2 { font-size: 20px; font-weight: 600; }
  .journal-list a:hover { color: var(--accent); }
  .journal-list time { display: block; margin-top: 4px; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .journal-list p { margin-top: 10px; color: var(--ink-2); }
</style>
