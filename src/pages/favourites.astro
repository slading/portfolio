---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { movies } from '../data/favourites';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
// Posters are shown only when the file exists under public/ at build time; otherwise a
// neutral placeholder is rendered, so the grid never shows a broken image.
const hasPoster = (poster?: string) => Boolean(poster) && existsSync(join(process.cwd(), 'public', poster!));
---

<Base title="Favourite Movies | Yauheni Buka">
  <section class="page-head reveal show" aria-labelledby="fav-title">
    <h1 id="fav-title" class="page-title" data-i18n="pages.favourites.title">{t('pages.favourites.title')}</h1>
    <p class="page-intro" data-i18n="pages.favourites.intro">{t('pages.favourites.intro')}</p>
  </section>

  <section class="section reveal show" aria-labelledby="fav-movies">
    <p class="kicker" id="fav-movies" data-i18n="pages.favourites.moviesKicker">{t('pages.favourites.moviesKicker')}</p>

    {movies.length === 0 ? (
      <div class="cv-empty" role="status" style="margin-top:16px">
        <p class="cv-empty-title" data-i18n="pages.favourites.emptyTitle">{t('pages.favourites.emptyTitle')}</p>
        <p class="muted" data-i18n="pages.favourites.emptyText">{t('pages.favourites.emptyText')}</p>
      </div>
    ) : (
      <ul class="poster-grid">
        {movies.map((m) => (
          <li>
            <figure class="poster-card">
              <div class:list={['poster-frame', m.fit === 'contain' && 'is-contain']}>
                {hasPoster(m.poster) ? (
                  <img
                    class:list={[m.fit === 'contain' && 'is-contain']}
                    src={`${base}${m.poster}`}
                    alt={`${m.title} (${m.year})`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="poster-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="16" rx="2" />
                      <path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4" />
                    </svg>
                  </div>
                )}
              </div>
              <figcaption class="poster-caption">
                <span class="poster-title">{m.title}</span>
                <span class="poster-meta">
                  <span>{m.year}</span>
                  {m.kind === 'series' && (
                    <>
                      <span aria-hidden="true"> · </span>
                      <span data-i18n="pages.favourites.tvSeries">{t('pages.favourites.tvSeries')}</span>
                    </>
                  )}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
