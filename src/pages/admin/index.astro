---
import Base from '../../layouts/Base.astro';
import '../../styles/admin.css';
import { adminClient, privateHeaders } from '../../lib/server/auth';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
if (!await adminClient(Astro)) return privateHeaders(Astro.redirect('/admin/login', 303));
---

<Base title="Dashboard | EXO" noindex>
  <section class="section admin-shell">
    <div class="admin-head">
      <div><p class="kicker">Private space</p><h1 class="page-title">Dashboard</h1></div>
      <form action="/api/admin/logout" method="post"><button class="btn" type="submit">Sign out</button></form>
    </div>
    <p class="page-intro">Your journal, from first thought to published entry.</p>
    <div class="admin-actions" style="margin-top:24px">
      <a class="btn btn-primary" href="/admin/posts/new">Write a post</a>
      <a class="btn" href="/admin/posts">Manage posts</a>
    </div>
  </section>
</Base>
