---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { cvFile } from '../data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const pdfHref = `${base}${cvFile}`;
// Checked at build time against the project root (import.meta.url points into the
// compiled output, not src/): the viewer only renders when the owner's CV is in public/.
const hasCv = existsSync(join(process.cwd(), 'public', cvFile));
---

<Base title="Resume | Yauheni Buka">
  <section class="page-head reveal show" aria-labelledby="resume-title">
    <div class="page-head-row">
      <div>
        <h1 id="resume-title" class="page-title" data-i18n="pages.resume.title">{t('pages.resume.title')}</h1>
        <p class="page-intro" data-i18n="pages.resume.intro">{t('pages.resume.intro')}</p>
      </div>
      <div class="page-actions">
        {hasCv ? (
          <a class="btn" href={pdfHref} target="_blank" rel="noopener noreferrer" data-i18n="pages.resume.openPdf">
            {t('pages.resume.openPdf')} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="btn" aria-disabled="true" data-i18n="pages.resume.openPdf">{t('pages.resume.openPdf')}</span>
        )}
        {hasCv ? (
          <a class="btn btn-primary" href={pdfHref} download data-i18n="pages.resume.download">{t('pages.resume.download')}</a>
        ) : (
          <span class="btn btn-primary" aria-disabled="true" data-i18n="pages.resume.download">{t('pages.resume.download')}</span>
        )}
      </div>
    </div>

    {hasCv ? (
      <>
        <div class="cv-frame">
          <iframe src={`${pdfHref}#view=FitH`} title={t('pages.resume.viewerTitle')} data-i18n-title="pages.resume.viewerTitle" loading="lazy"></iframe>
        </div>
        <p class="muted cv-fallback" data-i18n="pages.resume.viewerFallback">{t('pages.resume.viewerFallback')}</p>
      </>
    ) : (
      <div class="cv-empty" role="status">
        <p class="cv-empty-title" data-i18n="pages.resume.pendingTitle">{t('pages.resume.pendingTitle')}</p>
        <p class="muted" data-i18n="pages.resume.pendingText">{t('pages.resume.pendingText')}</p>
      </div>
    )}
  </section>
</Base>
