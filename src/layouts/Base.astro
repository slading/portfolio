---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { DEFAULT_LANG, messages } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const dict = messages[DEFAULT_LANG];
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={DEFAULT_LANG} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f2efe8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Runs before first paint: marks JS as available and applies the saved (or system) theme. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try {
          t = localStorage.getItem('portfolio-theme') || localStorage.getItem('zenia-theme');
        } catch (e) {}
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#top" data-i18n="ui.skip">{dict.ui.skip}</a>
    <div class="cursor" aria-hidden="true"></div>
    <div class="theme-wipe" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <MusicPlayer />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
