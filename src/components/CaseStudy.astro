---
import { DEFAULT_LANG, messages, t } from '../i18n';
import { assets, projects, type ProjectId } from '../data/projects';

interface Props {
  id: ProjectId;
}

const { id } = Astro.props;
const project = projects.find((p) => p.id === id);
if (!project) throw new Error(`Unknown project id: ${id}`);

const dict = messages[DEFAULT_LANG];
const c = dict.cases[id];
const path = `cases.${id}`;
const base = import.meta.env.BASE_URL;

/** Link labels are language-neutral, so they live here rather than in the dictionaries. */
const LINK_LABEL = { live: 'Live ↗', github: 'GitHub ↗' } as const;
const LINK_NOTE = { live: 'opensLive', github: 'opensRepo' } as const;
---

<section class="case" id={project.anchor} aria-labelledby={`${project.anchor}-title`}>
  <div class="container">
    <div class="section-head">
      <span class="kicker" data-i18n={`${path}.kicker`}>{c.kicker}</span>
      <span class="kicker" data-i18n={`${path}.kickerTitle`}>{c.kickerTitle}</span>
    </div>

    <div class="grid">
      <div class="col-5 reveal">
        <h2 id={`${project.anchor}-title`}>
          <span>{c.title}</span>
          <span data-i18n={`${path}.accent`}>{c.accent}</span>
        </h2>
        <p class="case-copy" data-i18n={`${path}.intro`}>{c.intro}</p>

        {id === 'n2d' && (
          <ul class="scope">
            {dict.cases.n2d.scope.map((s, i) => (
              <li data-i18n={`${path}.scope.${i}`}>{s}</li>
            ))}
          </ul>
        )}

        <div class="case-links">
          {project.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {LINK_LABEL[link.label]}
              <span class="sr-only" data-i18n={`ui.${LINK_NOTE[link.label]}`}>
                {t(`ui.${LINK_NOTE[link.label]}`)}
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="col-6 col-start-7 reveal">
        <div class="facts">
          {c.facts.map((fact, i) => (
            <div class="fact">
              <b data-i18n={`${path}.facts.${i}.label`}>{fact.label}</b>
              <span data-i18n={`${path}.facts.${i}.text`}>{fact.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    {id === 'n2d' && (
      <figure class="case-visual reveal">
        <div class="n2d-stage" data-parallax-stage>
          <div class="frame frame--staff" data-parallax="18">
            <span class="caption caption--staff" data-i18n={`${path}.visualCaptions.0`}>{dict.cases.n2d.visualCaptions[0]}</span>
            <iframe
              src={`${base}${assets.n2dStaff}`}
              title={dict.aria.staff}
              data-i18n-title="aria.staff"
              loading="lazy"
            />
          </div>
          <div class="frame frame--customer" data-parallax="-26">
            <span class="caption caption--customer" data-i18n={`${path}.visualCaptions.1`}>{dict.cases.n2d.visualCaptions[1]}</span>
            <iframe
              src={`${base}${assets.n2dCustomer}`}
              title={dict.aria.customer}
              data-i18n-title="aria.customer"
              loading="lazy"
            />
          </div>
        </div>
        <figcaption class="visual-note" data-i18n={`${path}.visualNote`}>{dict.cases.n2d.visualNote}</figcaption>
      </figure>
    )}

    {id === 'sentinel' && (
      <figure class="case-visual reveal">
        <img
          class="case-shot"
          src={`${base}${assets.sentinelShot}`}
          alt={dict.aria.sentinel}
          data-i18n-alt="aria.sentinel"
          width="1600"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    {id === 'solana' && (
      <div class="case-visual reveal">
        <div class="solana-proof">
          <span data-i18n={`${path}.proof.0`}>{dict.cases.solana.proof[0]}</span>
          <span class="arrow" aria-hidden="true">→</span>
          <strong data-i18n={`${path}.proof.1`}>{dict.cases.solana.proof[1]}</strong>
          <span class="arrow" aria-hidden="true">→</span>
          <span data-i18n={`${path}.proof.2`}>{dict.cases.solana.proof[2]}</span>
        </div>
      </div>
    )}
  </div>
</section>
