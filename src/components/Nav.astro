---
import { t } from '../i18n';
import BrandMark from './BrandMark.astro';

// Absolute, base-aware links so the nav works on every page, not only the homepage.
const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <nav class="nav-inner" aria-label={t('ui.navAria')}>
    <a class="brand" href={base} aria-label="Yauheni Buka — home"><BrandMark /></a>
    <ul class="nav-links">
      <li><a class="nav-link" href={base} data-i18n="nav.home">{t('nav.home')}</a></li>
      <li><a class="nav-link" href={`${base}#about`} data-i18n="nav.about">{t('nav.about')}</a></li>
      <li><a class="nav-link" href={`${base}#projects`} data-i18n="nav.projects">{t('nav.projects')}</a></li>
      <li class="nav-more">
        <details data-menu>
          <summary>
            <span data-i18n="ui.moreMenu">{t('ui.moreMenu')}</span>
            <span class="caret" aria-hidden="true">▾</span>
          </summary>
          <ul class="menu">
            <li><a href={`${base}resume/`} data-i18n="nav.resume">{t('nav.resume')}</a></li>
            <li><a href={`${base}favourites/`} data-i18n="nav.movies">{t('nav.movies')}</a></li>
          </ul>
        </details>
      </li>
    </ul>
    <span class="nav-spacer"></span>
    <button type="button" class="kbd-btn" data-search-open aria-haspopup="dialog" data-i18n-aria="ui.searchButton" aria-label={t('ui.searchButton')}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="search-label" data-i18n="ui.searchOpen">{t('ui.searchOpen')}</span>
      <span class="kbd" aria-hidden="true">{t('ui.searchShortcut')}</span>
    </button>
    <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label={t('ui.themeToDark')} title={t('ui.themeToDark')}>
      <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </nav>
</header>
