---
import { DEFAULT_LANG, t } from '../i18n';
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="#top" aria-label="Żenia Buka — home">ŻENIA<span aria-hidden="true">●</span>BUKA</a>
    <div class="topline" data-i18n="nav.topline">{t('nav.topline', DEFAULT_LANG)}</div>
    <nav class="nav" aria-label={t('ui.navAria', DEFAULT_LANG)}>
      <a class="nav-link is-hidden-sm" href="#works" data-i18n="nav.work">{t('nav.work', DEFAULT_LANG)}</a>
      <a class="nav-link" href="#contact" data-i18n="nav.contact">{t('nav.contact', DEFAULT_LANG)}</a>
      <div class="lang-switch" role="group" aria-label={t('ui.languageAria', DEFAULT_LANG)}>
        <button type="button" data-set-lang="pl" aria-pressed="false">PL</button>
        <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
      </div>
      <button type="button" class="theme-toggle" data-theme-toggle>
        <i aria-hidden="true"></i>
        <span class="label-text" data-theme-label>{t('nav.themeDark', DEFAULT_LANG)}</span>
      </button>
    </nav>
  </div>
</header>
