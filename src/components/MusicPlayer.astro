---
import { t } from '../i18n';
import { tracks } from '../data/music';

const hasTracks = tracks.length > 0;
const first = tracks[0];
const payload = JSON.stringify(tracks.map(({ id, title, artist, src, cover }) => ({ id, title, artist, src, cover })));
---

<section id="music" class="music-wrap" aria-labelledby="music-kicker">
  <div class="music" data-music data-tracks={payload}>
    <div class="music-cover">
      {first?.cover && <img data-music-cover src={first.cover} alt={t('music.coverAlt')} />}
      <svg data-music-placeholder style={first?.cover ? "display:none" : undefined} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
    </div>

    <div class="music-body">
      <div class="music-head">
        <span class="kicker" id="music-kicker" data-i18n="music.kicker">{t('music.kicker')}</span>
        <span class="kicker" data-music-counter>{hasTracks ? `1 / ${tracks.length}` : `0 ${t('music.trackCount')}`}</span>
      </div>

      <div>
        <div class="music-title" data-music-title>{first ? first.title : t('music.noTrackTitle')}</div>
        <div class="music-artist" data-music-artist>{first ? first.artist : t('music.noTrackArtist')}</div>
      </div>

      <div class="music-controls">
        <button type="button" class="ctrl" data-music-prev aria-label={t('music.prev')} data-i18n-aria="music.prev" disabled={!hasTracks}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg>
        </button>
        <button type="button" class="play-btn" data-music-play aria-label={t('music.play')} data-i18n-aria="music.play" disabled={!hasTracks}>
          <svg class="ic-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"/></svg>
        </button>
        <button type="button" class="ctrl" data-music-next aria-label={t('music.next')} data-i18n-aria="music.next" disabled={!hasTracks}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg>
        </button>

        <div class="progress">
          <span data-music-current>0:00</span>
          <input type="range" min="0" max="100" step="0.1" value="0" aria-label={t('music.seek')} data-i18n-aria="music.seek" data-music-seek disabled={!hasTracks} />
          <span data-music-duration>0:00</span>
        </div>
      </div>

      <audio data-music-audio preload="none"></audio>

      <div class="music-foot">
        <span data-music-status aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>
