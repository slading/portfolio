---
import { t } from '../i18n';
import { tracks, trackUrl } from '../data/music';

// All six tracks are in the markup in the owner's order. Without JavaScript the first one shows
// and the previous/next buttons stay hidden, so no control ever does nothing.
const pad = (n: number) => String(n).padStart(2, '0');
const total = tracks.length;
---

<section id="music" class="rotation-wrap" aria-labelledby="music-kicker">
  <div class="rotation" data-music>
    <div class="rotation-head">
      <span class="rotation-label" id="music-kicker" data-i18n="music.kicker">{t('music.kicker')}</span>
      <div class="rotation-nav">
        <span class="rotation-count" data-music-counter>{`${pad(1)} / ${pad(total)}`}</span>
        <div class="rotation-buttons">
          <button type="button" class="rotation-btn" data-music-prev aria-label={t('music.prev')} data-i18n-aria="music.prev">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button type="button" class="rotation-btn" data-music-next aria-label={t('music.next')} data-i18n-aria="music.next">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
      </div>
    </div>

    <ul class="rotation-list">
      {tracks.map((track, i) => (
        <li class="rotation-slide" data-music-slide hidden={i !== 0}>
          <div class="rotation-art">
            {track.artwork ? (
              <a href={trackUrl(track.spotifyId)} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                <img src={track.artwork} alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </a>
            ) : (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
            )}
          </div>
          <div class="rotation-text">
            <a class="rotation-title" href={trackUrl(track.spotifyId)} target="_blank" rel="noopener noreferrer" title={track.title}>{track.title}</a>
            <span class="rotation-artist">{track.artist}</span>
            <a class="rotation-open" href={trackUrl(track.spotifyId)} target="_blank" rel="noopener noreferrer" data-i18n="music.openSpotify">{t('music.openSpotify')}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
