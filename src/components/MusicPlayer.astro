---
import { t } from '../i18n';
import { tracks, trackUrl, embedHeight, type Track } from '../data/music';

const first = tracks[0] as Track;
const payload = JSON.stringify(
  tracks.map(({ spotifyId, title, artist, artwork }) => ({ spotifyId, title, artist, artwork: artwork ?? null })),
);
---

<section id="music" class="music-wrap" aria-labelledby="music-kicker">
  <div class="music" data-music data-tracks={payload} data-embed-height={embedHeight} data-state="idle">
    <div class="music-cover">
      {first?.artwork && <img data-music-cover src={first.artwork} alt={t('music.coverAlt')} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
      <svg data-music-placeholder style={first?.artwork ? 'display:none' : undefined} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
    </div>

    <div class="music-body">
      <div class="music-head">
        <span class="kicker" id="music-kicker" data-i18n="music.kicker">{t('music.kicker')}</span>
        <span class="kicker" data-music-counter>{`1 / ${tracks.length}`}</span>
      </div>

      <div class="music-titlerow">
        <div class="music-meta">
          <div class="music-title" data-music-title>{first.title}</div>
          <div class="music-artist" data-music-artist>{first.artist}</div>
        </div>
        <span class="eq" data-music-eq aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <div class="music-controls">
        <button type="button" class="ctrl" data-music-prev aria-label={t('music.prev')} data-i18n-aria="music.prev">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
        </button>
        <button type="button" class="play-btn" data-music-play aria-label={t('music.play')} data-i18n-aria="music.play" aria-pressed="false">
          <svg class="ic-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>
          <svg class="ic-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
        </button>
        <button type="button" class="ctrl" data-music-next aria-label={t('music.next')} data-i18n-aria="music.next">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
        </button>

        <div class="progress" aria-hidden="true">
          <span data-music-current>0:00</span>
          <div class="progress-bar" data-music-bar><span data-music-fill></span></div>
          <span data-music-duration>0:00</span>
        </div>
      </div>

      <div class="music-embed" data-music-embed hidden></div>

      <div class="music-foot">
        <a class="music-open" data-music-open href={trackUrl(first.spotifyId)} target="_blank" rel="noopener noreferrer" data-i18n="music.openSpotify">{t('music.openSpotify')}</a>
        <span data-music-status aria-live="polite"></span>
      </div>
      <p class="music-note" data-i18n="music.note">{t('music.note')}</p>
    </div>
  </div>
</section>
