---
import { DEFAULT_LANG, messages, t } from '../i18n';
import { assets } from '../data/projects';

const base = import.meta.env.BASE_URL;
const items = messages[DEFAULT_LANG].works.items;

const rows = [
  { key: 'n2d' as const, index: '01', name: 'N2D', anchor: 'case-n2d' },
  { key: 'sentinel' as const, index: '02', name: 'SentinelAI', anchor: 'case-sentinel' },
  { key: 'solana' as const, index: '03', name: 'Solana On-chain Intelligence Assistant', anchor: 'case-solana' },
];
---

<section class="section works" id="works" aria-labelledby="works-title">
  <div class="container">
    <div class="work-intro grid reveal">
      <h2 id="works-title" data-i18n-html="works.titleHtml" set:html={t('works.titleHtml')} />
      <div class="crew">
        <strong data-i18n="works.count">{t('works.count')}</strong><br /><br />
        <span data-i18n="works.hint">{t('works.hint')}</span>
      </div>
    </div>

    <ol class="work-list reveal-fade" role="list">
      {
        rows.map((row) => (
          <li>
            <a class="work-row" href={`#${row.anchor}`} data-cursor-label={t('ui.cursorView')}>
              <span class="work-index">{row.index}</span>
              <h3 class="work-title">{row.name}</h3>
              <span class="work-meta" data-i18n={`works.items.${row.key}.meta`}>{items[row.key].meta}</span>

              <span class="work-preview" aria-hidden="true">
                <span class="preview-body">
                  {row.key === 'n2d' && (
                    <span class="frame">
                      <iframe
                        src={`${base}${assets.n2dStaff}`}
                        title="N2D production booking system preview"
                        loading="lazy"
                        tabindex="-1"
                      />
                    </span>
                  )}
                  {row.key === 'sentinel' && (
                    <img src={`${base}${assets.sentinelShot}`} alt="" width="1600" height="1280" loading="lazy" />
                  )}
                  {row.key === 'solana' && (
                    <span class="solana-preview">
                      <span>RAW RPC</span>
                      <strong>NORMALIZED<br />TRANSACTION</strong>
                      <span>DIAGNOSTICS ↗</span>
                    </span>
                  )}
                  <b class="preview-label" data-i18n={`works.items.${row.key}.preview`}>{items[row.key].preview}</b>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
