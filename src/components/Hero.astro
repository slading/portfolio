---
import { t } from '../i18n';

const base = import.meta.env.BASE_URL;
import { contactEmail, githubProfile } from '../data/projects';
import MusicPlayer from './MusicPlayer.astro';
import { siGithub } from 'simple-icons';
---

<section id="about" class="hero reveal" aria-labelledby="hero-name">
  <div class="banner">
    <picture>
      <source
        type="image/webp"
        srcset={`${base}images/hero-banner-800.webp 800w, ${base}images/hero-banner-1080.webp 1080w`}
        sizes="(max-width: 820px) 100vw, 820px"
      />
      <img
        src={`${base}images/hero-banner-1080.webp`}
        width="1080"
        height="462"
        alt={t('hero.bannerLabel')}
        data-i18n-alt="hero.bannerLabel"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="hero-body">
    <picture class="avatar-picture">
      <source
        type="image/webp"
        srcset={`${base}images/profile-avatar-256.webp 256w, ${base}images/profile-avatar-512.webp 512w`}
        sizes="96px"
      />
      <img
        src={`${base}images/profile-avatar-512.webp`}
        width="512"
        height="602"
        alt={t('hero.avatarLabel')}
        data-i18n-alt="hero.avatarLabel"
        decoding="async"
      />
    </picture>

    <div class="hero-top">
      <div style="min-width:0; flex:1 1 380px">
        <h1 id="hero-name" class="hero-name" data-i18n="hero.name">{t('hero.name')}</h1>
        <p class="hero-title" data-i18n="hero.title">{t('hero.title')}</p>
        <p class="hero-intro" data-i18n="hero.intro">{t('hero.intro')}</p>
      </div>
    </div>

    <div class="hero-actions">
      <a class="btn btn-primary" href={`mailto:${contactEmail}`} data-i18n="hero.emailCta">{t('hero.emailCta')}</a>
      <a class="btn" href={githubProfile} target="_blank" rel="noopener noreferrer" data-i18n="hero.githubCta" data-i18n-title="ui.opensRepo">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
        {t('hero.githubCta')}
      </a>
    </div>

    <div class="hero-meta">
      <span data-i18n="hero.location">{t('hero.location')}</span>
      <span class="clock" aria-label={t('ui.warsawTime')}>
        <span class="clock-dot" aria-hidden="true"></span>
        <span data-i18n="ui.warsawTime">{t('ui.warsawTime')}</span>
        <strong data-warsaw-time>--:--</strong>
      </span>
      <span class="socials" aria-label="Social links">
        <a class="social" href={githubProfile} target="_blank" rel="noopener noreferrer" data-i18n-title="ui.opensRepo" title="GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
          GitHub
        </a>
        <a class="social" href={`mailto:${contactEmail}`} title={contactEmail}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          Email
        </a>
      </span>
    </div>

    <MusicPlayer />
  </div>
</section>
