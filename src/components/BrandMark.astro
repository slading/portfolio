---
/**
 * Exotision "E" mark. Monochrome: fills with currentColor so it follows the theme.
 * Geometry is shared with public/favicon.svg. Keep the two in sync.
 * Three arms end in slanted cuts, and a detached square sits beside the middle arm.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="5" y="5" width="5" height="22" />
  <path d="M5 5H24L20 10.5H10Z" />
  <path d="M10 14H20L17 18H10Z" />
  <path d="M5 27H24L20 21.5H10Z" />
  <rect class="brand-accent" x="23.5" y="14" width="3.5" height="4" />
</svg>
